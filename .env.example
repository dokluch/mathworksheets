# Copy to .env.local (git-ignored). All values are optional.

# GA4 measurement id. Analytics is a complete no-op when unset.
VITE_GA_MEASUREMENT_ID=

# Canonical origin used for canonical/og:url/sitemap/llms.txt links.
# Set this when moving to a custom domain.
VITE_SITE_URL=https://mathworksheets-eight.vercel.app
