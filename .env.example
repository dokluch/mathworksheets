# Copy to .env.local (git-ignored). All values are optional.

# GA4 measurement id. Defaults to the production property on
# superawesomemath.com only; dev servers and preview deploys stay silent.
# Set it to force analytics on anywhere, or to a non-G- value to disable it.
VITE_GA_MEASUREMENT_ID=

# Canonical origin used for canonical/og:url/sitemap/llms.txt links.
# Defaults to the production origin; override for a preview or a local build.
VITE_SITE_URL=
